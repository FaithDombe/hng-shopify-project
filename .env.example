MAILGUN_DOMAIN=your-verified-mailgun-domain
MAILGUN_FROM=Shop Name <orders@your-verified-domain.com>
# For Mailgun EU accounts, use https://api.eu.mailgun.net
MAILGUN_API_BASE_URL=https://api.mailgun.net

