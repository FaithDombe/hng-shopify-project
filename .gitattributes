# Normalise line endings: store LF in the repository, check out native on Windows.
# Keeps diffs clean when the project is opened on different platforms.
* text=auto

# Generated files should always use LF, whatever the platform.
package-lock.json text eol=lf
*.md text eol=lf

# Binary assets — never touched or converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
